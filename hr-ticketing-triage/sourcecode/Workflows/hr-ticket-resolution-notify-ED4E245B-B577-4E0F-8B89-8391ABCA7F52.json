{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hrt_Office365Outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hrt_SharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "HR Shared Mailbox (hrt_SharedMailbox)": {
          "defaultValue": "hr@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "hrt_SharedMailbox"
          }
        },
        "HR SharePoint Site (hrt_SPSite)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HR",
          "type": "String",
          "metadata": {
            "schemaName": "hrt_SPSite"
          }
        },
        "HR Tickets List (hrt_TicketsList)": {
          "defaultValue": "HR Tickets",
          "type": "String",
          "metadata": {
            "schemaName": "hrt_TicketsList"
          }
        },
        "HR Triage Settings (hrt_TriageSettings)": {
          "defaultValue": {
            "confidenceThreshold": 0.7,
            "maxBodyChars": 6000,
            "ticketPrefix": "HR-",
            "templateSubjectKeyword": "HR Request",
            "sendAcknowledgement": true,
            "copyAttachments": true,
            "moveEmails": true,
            "logDecisions": true,
            "folders": {
              "ticketed": "<folder id of Inbox/Triage - Ticketed>",
              "noAction": "<folder id of Inbox/Triage - No Action>",
              "review": "<folder id of Inbox/Triage - Review>"
            },
            "ignoreSenderPatterns": [
              "noreply",
              "no-reply",
              "donotreply",
              "do-not-reply",
              "mailer-daemon",
              "postmaster",
              "notifications@",
              "newsletter"
            ],
            "ignoreSubjectPrefixes": [
              "automatic reply",
              "auto-reply",
              "autoreply",
              "out of office",
              "undeliverable",
              "delivery status notification",
              "delivery has failed",
              "accepted:",
              "declined:",
              "tentative:",
              "canceled:",
              "read:",
              "recall:"
            ],
            "categories": [
              "Payroll",
              "Benefits",
              "Leave & Absence",
              "Onboarding",
              "Offboarding",
              "Employee Relations",
              "Policy Question",
              "Employment Verification",
              "Personal Data Change",
              "Recruiting",
              "Training",
              "Other"
            ],
            "routing": {
              "Payroll": "payroll.specialist@contoso.com",
              "Benefits": "benefits.specialist@contoso.com",
              "Leave & Absence": "benefits.specialist@contoso.com",
              "Onboarding": "hr.generalist@contoso.com",
              "Offboarding": "hr.generalist@contoso.com",
              "Employee Relations": "hr.business.partner@contoso.com",
              "Employment Verification": "hr.coordinator@contoso.com",
              "Personal Data Change": "hr.coordinator@contoso.com",
              "Recruiting": "talent.acquisition@contoso.com",
              "default": "hr.coordinator@contoso.com"
            },
            "sensitiveAssignee": "hr.director@contoso.com",
            "slaHours": {
              "Urgent": 4,
              "High": 24,
              "Medium": 72,
              "Low": 120
            },
            "adminEmail": "hr.ops@contoso.com",
            "digestRecipients": "hr-team@contoso.com",
            "autoCloseResolvedAfterDays": 5
          },
          "type": "Object",
          "metadata": {
            "schemaName": "hrt_TriageSettings"
          }
        }
      },
      "triggers": {
        "When_a_ticket_is_created_or_modified": {
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "conditions": [
            {
              "expression": "@equals(triggerOutputs()?['body/Status']?['Value'], 'Resolved')"
            },
            {
              "expression": "@not(equals(triggerOutputs()?['body/ResolutionNotified'], true))"
            },
            {
              "expression": "@not(empty(triggerOutputs()?['body/RequesterEmail']))"
            }
          ],
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('HR SharePoint Site (hrt_SPSite)')",
              "table": "@parameters('HR Tickets List (hrt_TicketsList)')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Fires only when Status = Resolved and the requester has not been told yet."
        }
      },
      "actions": {
        "Initialize_Settings": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Settings",
                "type": "object",
                "value": "@parameters('HR Triage Settings (hrt_TriageSettings)')"
              }
            ]
          }
        },
        "Try": {
          "runAfter": {
            "Initialize_Settings": [
              "Succeeded"
            ]
          },
          "type": "Scope",
          "actions": {
            "Send_resolution_email_from_shared_mailbox": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('HR Shared Mailbox (hrt_SharedMailbox)')",
                  "emailMessage/To": "@triggerOutputs()?['body/RequesterEmail']",
                  "emailMessage/Subject": "Resolved: @{triggerOutputs()?['body/Title']} [@{triggerOutputs()?['body/TicketNumber']}]",
                  "emailMessage/Body": "<p>Hello,</p><p>Your HR request <b>@{triggerOutputs()?['body/TicketNumber']}</b> (&quot;@{triggerOutputs()?['body/Title']}&quot;) has been resolved.</p><p><b>Resolution:</b><br/>@{coalesce(triggerOutputs()?['body/ResolutionNotes'], 'See previous correspondence.')}</p><p>If anything is still outstanding, just reply to this email and keep <b>[@{triggerOutputs()?['body/TicketNumber']}]</b> in the subject - the ticket will be reopened for the team.</p><p>Kind regards,<br/>HR Team</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Mark_resolution_notified": {
              "runAfter": {
                "Send_resolution_email_from_shared_mailbox": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('HR SharePoint Site (hrt_SPSite)')",
                  "table": "@parameters('HR Tickets List (hrt_TicketsList)')",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item/Title": "@triggerOutputs()?['body/Title']",
                  "item/ResolutionNotified": true,
                  "item/ResolvedOn": "@utcNow()"
                },
                "authentication": "@parameters('$authentication')"
              },
              "description": "Setting the flag stops the trigger condition from firing again on this update."
            }
          }
        },
        "Catch": {
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Scope",
          "actions": {
            "Send_failure_alert": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@variables('Settings')?['adminEmail']",
                  "emailMessage/Subject": "[HR Triage] HR ticket resolution notification failed",
                  "emailMessage/Body": "<p>The <b>HR ticket resolution notification</b> flow failed.</p><p><a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\">Open the failed run</a></p><p>Check the run history; the email (if any) has been left in the shared mailbox Inbox so it can be re-processed or handled manually.</p>",
                  "emailMessage/Importance": "High"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Terminate_as_failed": {
              "runAfter": {
                "Send_failure_alert": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HRTriageFailed",
                  "message": "HR ticket resolution notification failed - see Try scope"
                }
              }
            }
          },
          "description": "Catch: alerts the HR automation admin with a link to the failed run."
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
